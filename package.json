{
  "name": "@aribrilliantsyah/ryunacdn",
  "version": "1.0.0",
  "private": false,
  "description": "RyunaCDN — high-performance just-in-time image & asset CDN. Fork of DADI CDN, modernised for Node 22+ and TypeScript.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "aribrilliantsyah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aribrilliantsyah/ryunacdn.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ryunacdn": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && node dist/index.js",
    "prod": "pnpm build && pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "prod:restart": "pm2 restart ecosystem.config.cjs",
    "prod:logs": "pm2 logs ryunacdn",
    "prod:status": "pm2 status",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/sensible": "^6.0.1",
    "accept-language-parser": "^1.5.0",
    "cacache": "^19.0.1",
    "chokidar": "^4.0.1",
    "cron": "^3.5.0",
    "etag": "^1.8.1",
    "exif-reader": "^2.0.1",
    "fastify": "^5.2.0",
    "file-type": "^19.6.0",
    "gifwrap": "^0.10.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lightningcss": "^1.28.2",
    "maxmind": "^4.3.24",
    "mime": "^4.0.4",
    "node-vibrant": "^4.0.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^24.0.0",
    "sharp": "^0.34.0",
    "smartcrop-sharp": "^2.0.6",
    "terser": "^5.36.0",
    "ua-parser-js": "^2.0.0",
    "undici": "^7.0.0",
    "url-join": "^5.0.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "puppeteer",
      "sharp"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/accept-language-parser": "^1.5.6",
    "@types/cacache": "^17.0.2",
    "@types/etag": "^1.8.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autocannon": "^8.0.0",
    "pm2": "^5.4.3",
    "tsx": "4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
