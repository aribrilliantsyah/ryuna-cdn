# RyunaCDN — environment variables
#
# Copy: cp .env.example .env
# Env always wins over config/config.{NODE_ENV}.json at boot.
# All values shown are defaults; uncomment to override.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PROTOCOL=http
# RYUNACDN_NO_BANNER=true                # hide ASCII boot banner (CI)

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED for /token + /api/* protected routes.
# AUTH_CLIENT_ID=
# AUTH_SECRET=
# AUTH_KEY=                              # JWT signing secret (HS256). Rotate!

# ─── Cache backend ────────────────────────────────────────────────────────────
# CACHE_ENABLE_DIRECTORY=true            # disk cache on
# CACHE_ENABLE_REDIS=false               # redis cache off
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── S3 / DigitalOcean Spaces (images) ────────────────────────────────────────
# AWS_S3_IMAGES_ACCESS_KEY=
# AWS_S3_IMAGES_SECRET_KEY=
# AWS_S3_IMAGES_BUCKET_NAME=
# AWS_S3_IMAGES_REGION=
# AWS_S3_IMAGES_ENDPOINT=                # for DO Spaces / MinIO / R2

# ─── S3 / DigitalOcean Spaces (assets) ────────────────────────────────────────
# AWS_S3_ASSETS_ACCESS_KEY=
# AWS_S3_ASSETS_SECRET_KEY=
# AWS_S3_ASSETS_BUCKET_NAME=
# AWS_S3_ASSETS_REGION=
# AWS_S3_ASSETS_ENDPOINT=

# ─── CloudFront sync on /api/flush ────────────────────────────────────────────
# CLOUDFRONT_ACCESS_KEY=
# CLOUDFRONT_SECRET_KEY=
# CLOUDFRONT_DISTRIBUTION=

# ─── Runtime tuning (single-deploy burst stability) ───────────────────────────
# SHARP_CONCURRENCY=4                    # sharp threads per worker. default max(1, cpus/4)
# SHARP_CACHE_MEMORY_MB=64               # sharp internal cache cap
# SHARP_CACHE_FILES=0                    # sharp cache file handle cap (0 = unlimited)
# SHARP_CACHE_ITEMS=100                  # sharp cache items cap
# RYUNACDN_QUEUE_CONCURRENCY=8           # bounded WorkQueue concurrent transforms
# RYUNACDN_CONNECTION_TIMEOUT_MS=60000   # socket idle
# RYUNACDN_REQUEST_TIMEOUT_MS=120000     # total request lifecycle
# RYUNACDN_KEEPALIVE_TIMEOUT_MS=5000     # HTTP keep-alive
# RYUNACDN_SHUTDOWN_TIMEOUT_MS=4000      # graceful drain timeout on SIGTERM

# ─── Security hardening ───────────────────────────────────────────────────────
# RYUNACDN_MAX_MEGAPIXELS=100            # pixel bomb guard (reject 413)
# RYUNACDN_UPLOAD_MAX_BYTES=10485760     # per-file upload cap (10 MB)
# RYUNACDN_UPLOAD_MAX_FILES=1            # files per multipart request
# RYUNACDN_UPLOAD_MAX_FIELDS=5           # extra fields per multipart request
